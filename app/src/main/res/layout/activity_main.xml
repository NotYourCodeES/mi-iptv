<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <!-- Channel banner (bottom) -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingTop="72dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_logo_big">

            <TextView
                android:id="@+id/osdInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text2"
                android:textSize="32sp" />

            <ImageView
                android:id="@+id/osdLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/osdNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/osdName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/osdFav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="★"
                    android:textColor="@color/gold"
                    android:textSize="26sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_live" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="@string/osd_live"
                    android:textColor="@color/live"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/osdGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/osd_hints"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Channel list with live preview -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="26dp"
        android:paddingEnd="40dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/dot_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- Body: categories · channels · preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/section_categories" />

                <ListView
                    android:id="@+id/groupList"
                    style="@style/PanelList"
                    android:nextFocusRight="@+id/channelList" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/channelsTitle"
                    style="@style/SectionTitle"
                    android:text="@string/section_channels" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ListView
                        android:id="@+id/channelList"
                        style="@style/PanelList"
                        android:nextFocusLeft="@+id/groupList"
                        android:nextFocusRight="@+id/channelList" />

                    <TextView
                        android:id="@+id/channelsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/favorites_empty"
                        android:textColor="@color/muted"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Preview -->
            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/previewFrame"
                    android:layout_width="match_parent"
                    android:layout_height="174dp"
                    android:background="@drawable/bg_preview">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/playerPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        app:resize_mode="fit"
                        app:show_buffering="when_playing"
                        app:shutter_background_color="#000000"
                        app:surface_type="texture_view"
                        app:use_controller="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_pill"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/preview_badge"
                        android:textColor="@color/text2"
                        android:textSize="10sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/previewName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/previewFav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="★"
                        android:textColor="@color/gold"
                        android:textSize="22sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/previewMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/previewHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/KeyCap" android:text="@string/key_ok" />
                        <TextView style="@style/KeyLabel" android:text="@string/hint_watch" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/KeyCap" android:text="@string/key_hold_ok" />
                        <TextView style="@style/KeyLabel" android:text="@string/hint_favorite" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/KeyCap" android:text="@string/key_guide" />
                        <TextView style="@style/KeyLabel" android:text="@string/hint_guide" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/KeyCap" android:text="@string/key_back" />
                        <TextView style="@style/KeyLabel" android:text="@string/hint_back" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/footerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:textColor="#5E6A80"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Welcome / loading / error -->
    <FrameLayout
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="440dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/dot_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="@color/text"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/welcomeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text2"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/welcomeUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_url"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:textColor="#BFD2FF"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/welcomeProgress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:indeterminateTint="@color/accent"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/welcomeStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FF8A9B"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/welcomeQr"
                android:layout_width="204dp"
                android:layout_height="204dp"
                android:layout_marginStart="56dp"
                android:background="@drawable/bg_qr"
                android:padding="12dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </FrameLayout>

    <!-- Channel number being typed with the number keys -->
    <TextView
        android:id="@+id/numberEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_pill"
        android:fontFamily="sans-serif-medium"
        android:minWidth="120dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingTop="10dp"
        android:paddingEnd="28dp"
        android:paddingBottom="10dp"
        android:textColor="@color/accent"
        android:textSize="44sp"
        android:visibility="gone" />

    <!-- Code shown while a phone is being paired -->
    <FrameLayout
        android:id="@+id/pairingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9050810"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/pair_badge"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/pair_title"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/pairingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pairingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_url"
                android:fontFamily="monospace"
                android:paddingStart="36dp"
                android:paddingTop="12dp"
                android:paddingEnd="36dp"
                android:paddingBottom="12dp"
                android:textColor="@color/accent"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_hint"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Short notices -->
    <TextView
        android:id="@+id/toastText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
